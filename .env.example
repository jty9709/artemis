# ==============================================================================
# Artemis Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API credentials:
# cp .env.example .env

# Single OpenAI-compatible endpoint (used by every agent and memory lens).
# Use the API root, usually ending in /v1, not /chat/completions.
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=
# Must support image inputs and tool calling.
OPENAI_MODEL=
# Optional OCR uses the same model. Disabled by default to keep local UI-tree
# inspection free of model requests unless OCR is explicitly enabled.
ARTEMIS_OCR_ENABLED=false

# Android ADB Connectivity (Optional - defaults to 127.0.0.1:5037)
ADB_HOST=127.0.0.1
ADB_PORT=5037
# ADB_DEVICE_SERIAL=
# Keep the display awake, falling back to a wake lock or safe heartbeat when needed.
# Set to false if Artemis is used with a personal device whose screen should time out.
ARTEMIS_KEEP_DEVICE_AWAKE=true
# UI hierarchy backend: auto (Accessibility Helper, UIAutomator2 fallback) | helper | uiautomator
ARTEMIS_HIERARCHY_BACKEND=auto
# Let tasks install / upgrade the Accessibility Helper APK on a device they hold.
# Set to false on shared or personal phones: then only `artemis helper install` installs it.
ARTEMIS_HELPER_AUTO_INSTALL=true

# Artemis Execution Defaults (flash or pro)
ARTEMIS_DEFAULT_PROFILE=flash
